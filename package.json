{
  "name": "smartflow-nlex-monorepo",
  "version": "1.0.0",
  "description": "SmartFlow NLEX - Traffic Management Mobile App with Backend API",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "setup": "npm install",
    "frontend": "npm run dev -w frontend",
    "backend": "npm run dev -w backend",
    "dev": "npm run frontend & npm run backend",
    "type-check": "npm run type-check -w frontend && npm run type-check -w backend",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "keywords": [
    "react-native",
    "expo",
    "traffic",
    "navigation",
    "typescript"
  ],
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  }
}
