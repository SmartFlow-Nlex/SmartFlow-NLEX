# Copy this file to `.env` and fill in the values, then restart the dev server.
# Expo inlines EXPO_PUBLIC_* at bundle time, so a Fast Refresh will not pick up
# a change here.

# Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The anon / publishable key ONLY. Never the service_role key: it bypasses Row
# Level Security and must not ship inside a mobile app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# The SmartFlow dashboard backend runs on whichever teammate's laptop is
# hosting. Uncomment and set to that machine's LAN IP.
# EXPO_PUBLIC_API_HOST=192.168.2.196

# Once the backend is deployed to Render (see render.yaml), set this to its
# public URL. The app then no longer depends on a laptop being on, or on the
# LAN address changing every time the Wi-Fi does.
# EXPO_PUBLIC_BACKEND_API_URL=https://smartflow-backend.onrender.com

# The Google Apps Script that sends a new account its welcome email. Setup steps
# are in supabase/welcome-email.gs. Without this, sign-up works but sends nothing.
# EXPO_PUBLIC_WELCOME_EMAIL_URL=https://script.google.com/macros/s/<deployment id>/exec

# Mapbox public token, for drawing the interchange map with the same library
# the dashboard uses. Get one from https://account.mapbox.com - a pk.* token is
# meant to ship inside a client, so restrict it by URL rather than hiding it.
#
# Leave it unset and the app uses the platform maps instead: Apple Maps on iOS,
# Google Maps on Android. Everything still works, it just will not match the
# dashboard's look.
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-token-here
